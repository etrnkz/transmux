{
  "name": "transmux",
  "version": "1.1.0",
  "description": "Browser video player that plays legacy AVI/MKV by remuxing in WebAssembly and streams before conversion finishes. Exports real MP4. No uploads, no server.",
  "type": "module",
  "main": "wasm-video-player.js",
  "exports": {
    ".": "./wasm-video-player.js",
    "./stylesheet": "./wasm-video-player.css",
    "./worker": "./ffmpeg-worker.js"
  },
  "files": [
    "wasm-video-player.js",
    "wasm-video-player.css",
    "ffmpeg-worker.js",
    "webcodecs-encoder.js"
  ],
  "scripts": {
    "setup": "npm run setup-ffmpeg",
    "setup-ffmpeg": "node setup-local-ffmpeg.cjs",
    "serve": "python server.py 8000",
    "serve-basic": "python -m http.server 8000",
    "dev": "npm run serve",
    "build:rust": "wasm-pack build --target web --out-dir pkg",
    "clean": "rm -rf pkg target",
    "test": "node test-e2e.cjs",
    "test:embed": "node test-embed.cjs",
    "test:streaming": "node test-streaming-e2e.cjs",
    "test:accelerate": "node test-accelerate.cjs"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "video",
    "ffmpeg",
    "player",
    "avi",
    "mkv",
    "mse",
    "remux",
    "transmux"
  ],
  "author": "etrnkz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etrnkz/transmux.git"
  },
  "homepage": "https://github.com/etrnkz/transmux#readme",
  "bugs": {
    "url": "https://github.com/etrnkz/transmux/issues"
  },
  "devDependencies": {
    "wasm-pack": "^0.12.1"
  }
}
