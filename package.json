{
  "name": "wasm-video-player",
  "version": "1.0.0",
  "description": "Web-based video player using Rust + WebAssembly and FFmpeg.wasm",
  "main": "index.html",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "serve": "python server.py 8000",
    "serve-basic": "python -m http.server 8000",
    "dev": "npm run build && npm run serve",
    "clean": "rm -rf pkg target",
    "setup-ffmpeg": "node setup-local-ffmpeg.js",
    "setup": "npm run setup-ffmpeg && npm run build"
  },
  "keywords": [
    "rust",
    "webassembly",
    "wasm",
    "video",
    "ffmpeg",
    "player"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wasm-pack": "^0.12.1"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15"
  }
}
